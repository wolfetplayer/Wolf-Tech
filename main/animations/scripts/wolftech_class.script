	}
	weapons smg AND mg AND grenlauncher AND two_handed AND medcrate, movetype run
	{
		both jump_1step_2h
	}
	weapons smg AND mg AND grenlauncher AND two_handed AND medcrate
	{
		both jump_nostep_1h
	}
	default
	{
		both jump_1step_1h
	}
}
