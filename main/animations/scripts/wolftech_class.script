JUMP
{
	weapons sniper, movetype run
	{
		legs jump_1step_2h torso stand_rifle
	}
	weapons sniper
	{
		legs jump_nostep_1h torso stand_rifle
	}
	weapons self_loading, movetype run
	{
		legs jump_1step_2h
	}
	weapons self_loading
	{
		legs jump_nostep_1h
	}
	weapons panzer, movetype run
	{
		legs jump_1step_2h torso stand_panzer
	}
	weapons panzer
	{
		legs jump_nostep_1h torso stand_panzer
	}
	weapons one_handed AND akimbo, movetype run
	{
		both jump_1step_1h
