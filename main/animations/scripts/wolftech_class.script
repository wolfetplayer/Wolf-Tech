//==========================================================================
//
// WolfTech class character animation script
//
// Adapted from ET:Legacy's real animations/scripts/human_base.script (see
// main/etl/human_base.script for the reference copy) rather than hand-rolled
// from scratch. Two structural corrections vs. the previous version of this
// file, both load-bearing:
//
//   1) Real players always run with ps->aiState == AISTATE_COMBAT (forced in
//      G_ClientThink_real, g_active.c) - AISTATE_RELAXED/QUERY/ALERT are an
//      AI-only concept (ai_cast_*.c). BG_AnimScriptAnimation searches states
//      top-down from whatever state is requested (COMBAT -> ALERT -> QUERY
//      -> RELAXED) and stops at the first one with matching content, so the
//      old file "worked" only because it put everything under RELAXED and
//      let 3 empty states cascade down to it every single lookup. This file
//      puts real content under STATE COMBAT instead, matching both the
//      engine's actual per-frame lookup and ET's own reference script, and
//      leaves RELAXED/ALERT empty like ET does.
//
//   2) FIREWEAPON/RELOAD/RAISEWEAPON now animate torso only (not both), so
//      legs keep running/walking/crouching normally while firing instead of
//      snapping to a static firing stance every time a shot is fired - this
//      is ET's own explicit documented convention (see the EVENTS format
//      comment in the reference file) and fixes visibly broken-looking
//      movement during sustained fire.
//
// Weapon buckets below are cross-checked against each WP_'s weaponClass in
// bg_misc.c's ammoTable, then matched to the closest equivalent condition in
// the ET reference so the right clip family gets used:
//
//   sniper        WEAPON_CLASS_SCOPED
//   self_loading  WEAPON_CLASS_RIFLE_AUTO / ASSAULT_RIFLE (unscoped) - ET's
//                 Garand/FG42/K43 use the same _srifle clips even unscoped
//   smg           WEAPON_CLASS_SMG, plus Flamethrower/Venom/Tesla Gun - ET's
//                 own "machineguns" DEFINE bundles Flamethrower in with
//                 MP40/Thompson/Sten for exactly this clip family; Venom/
//                 Tesla have no ET equivalent, closest fit is the same
//                 automatic-two-handed-weapon carry pose
//   akimbo        WEAPON_CLASS_AKIMBO - only overrides FIREWEAPON/RELOAD/
//                 RAISEWEAPON; locomotion stays on one_handed since
//                 akimbo.mdx (now registered in human_base.anim) has no
//                 locomotion clips of its own, matching ET's own script
//   panzerfaust   WEAPON_CLASS_LAUNCHER
//   mg            WEAPON_CLASS_MG - carried/fired like ET's "Mobile MG42",
//                 not a mounted emplacement
//   grenlauncher  WEAPON_CLASS_RIFLENADE (M7) - analogous to ET's gpg40/
//                 gpg40a rifle-grenade-launcher attachment
//   one_handed    WEAPON_CLASS_PISTOL (incl. akimbo pistols, for movement)
//   medcrate      WEAPON_CLASS_MEDCRATE - ET's "medicheal"/"Ammo Pack" pose
//   two_handed    bolt-action rifles (Mauser/De Lisle/Mosin) and shotguns -
//                 ET's roster has no bolt-action rifle, so this bucket (and
//                 its "default" fallback) is a WolfTech-specific addition,
//                 not a direct port
//   melee         Knife
//   no_weapon     throwables/signal items with no better clip
//
// PAIN is upgraded from a flat default to ET's real impact_point-conditioned
// version (already-existing pain_* clips, just never wired up). DEATH stays
// as-is - ET's own human_base.script has no DEATH event block at all; ours
// predates this port and already uses valid clips, so it's left alone.
//
//==========================================================================

DEFINES

set weapons sniper = Sniper Scope AND Snooper Rifle AND M1941 Scope AND De Lisle Scope AND FG42 Scope
set weapons self_loading = M1 Garand AND FG42 Paratroop Rifle AND Browning Automatic Rifle AND MP44 Sturmgewehr AND G43 rifle AND M1941
set weapons smg = Thompson AND Sten AND MP40 AND MP34 AND PPSh-41 AND Flamethrower AND Venom AND Tesla Gun
set weapons akimbo = Dual Colts AND Dual TT-33s
set weapons panzer = Panzerfaust
set weapons mg = MG42 AND Browning M1919
set weapons grenlauncher = M7 Grenade Launcher
set weapons one_handed = Luger AND Colt AND sp5 pistol AND Revolver AND HDM AND TT-33 AND Dual Colts AND Dual TT-33s
set weapons medcrate = Medical Crate
set weapons two_handed = Mauser Rifle AND Ithaca 37 AND Auto-5 AND De Lisle Carbine AND Mosin-Nagant
set weapons melee = Knife
set weapons no_weapon = Grenade AND Pineapple AND Dynamite Weapon AND Landmine AND Airstrike Signal AND Artillery

set movetype moving = walk AND walkcr AND walkcrbk AND walkbk AND run AND runbk AND straferight AND strafeleft
set movetype crouching = idlecr AND walkcr AND walkcrbk
set movetype backstep = walkbk AND runbk AND walkcrbk

