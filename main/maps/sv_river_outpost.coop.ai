player
{

	spawn
	{
        #if g_survivalDifficulty == 0
		applyloadout survival_default
		#endif
		
        #if g_survivalDifficulty == 1
		applyloadout survival_hardcore
		#endif
		
		mu_start sound/music/l_briefing_2
	}
	
	trigger map_start
	{
		//If something breaks at late player joining, move it here
        accum 0 set 0     // number of friendlies already spawned
		globalaccum 0 set 0
	}
	
	playerstart
	{
		mu_stop 0 1000
		wait 2000
		mu_play sound/misc/prepare
	}
	
	trigger reinforce
	{
       accum 1 inc 1
	   alertentity friendly1
	   trigger player reinforce2
	}
	
	trigger reinforce2
	{
       accum 1 abort_if_less_than 2
	   alertentity friendly2
	   trigger player reinforce3
	}
	
	trigger reinforce3
	{
       accum 1 abort_if_less_than 3
	   alertentity friendly3
	   trigger player reinforce4
	}
	
	trigger reinforce4
	{
       accum 1 abort_if_less_than 4
	   alertentity friendly4
	   trigger player reinforce5
	}
	
	trigger reinforce5
	{
       accum 1 abort_if_less_than 5
	   alertentity friendly5
	   alertentity kill_reinforce1_relay
	   alertentity kill_reinforce2_relay
	}
	
	trigger player_using_radio
    {
        trigger radio static
    }

}

