// survival_default.surv
//
// Default balance values for GT_COOP_SURVIVAL, applied to every survival map.
// A map can override any subset of these keys with its own maps/<mapname>.surv
// file - anything the map file doesn't mention keeps the value set here.
//
// Format: one "key value" pair per line. // starts a line or trailing comment.
// This file is read server-side only (like .ai/.script/.ents); clients never
// read or trust it, so there's nothing here for a player to usefully edit
// on their own end.

// ---- Wave pacing ----
prepare_time            15   // seconds before wave 1 starts
intermission_time       15   // seconds between waves
initial_killcount_req    5   // kills required to clear wave 1
friendly_spawn_time     15   // seconds before a dead friendly AI can respawn

// ---- Game over (all players fallen) ----
// Cycles the view through 3 mapper-placed cameras (info_notnull ents targetnamed gameover_cam1/2/3), holds on cam3, then counts down to map_restart.
gameover_linger_time      4000   // ms, death-fall/GAME OVER text before cams start
gameover_cam_hold_time    4500   // ms, fully-visible hold time on cam1 and cam2 each (excludes fade in/out)
gameover_cam3_hold_time   2200   // ms, hold on cam3 before the countdown starts
gameover_fade_time         600   // ms, screen fade to/from black - runs once in and once out around every camera cut
gameover_countdown           5   // seconds counted down on cam3 before restart
gameover_music   sound/music/survival_game_over   // empty value = no music

// ---- Wave each enemy type first appears on ----
wave_eliteguard   3
wave_trench       5
wave_blackguard   7
wave_venom        9
wave_proto        10
//
wave_warriors     2
wave_flamers      4
//
wave_helga       10
wave_heinrich    15
wave_lopers       5
wave_priests      6
wave_xshepherds   4

// ---- Starting active-AI counts (wave 1) ----
initial_soldiers      5
initial_elites        0
initial_trench        0
initial_blackguards   0
initial_venoms        0
initial_protos        0
//
initial_zombies       5
initial_warriors      0
initial_flamers       0
//
// friendly AI count is auto-derived from how many ai_partisan (or other allied AI) entities are placed in the map - nothing to configure here
initial_lopers        0
initial_helgas        0
initial_heinrichs     0
initial_priests       0
initial_xshepherds    0

// ---- Per-wave increase / hard cap on active AI ----
max_soldiers         10
soldiers_increase     1
//
max_zombies          25
zombies_increase      1
//
max_flamers           3
flamers_increase      1
//
max_warriors          5
warriors_increase     1
//
max_elites            4
elites_increase       1
//
max_trench            4
trench_increase       1
//
max_blackguards       4
blackguards_increase  1
//
max_helgas            1
helgas_increase       1
//
max_heinrichs         1
heinrichs_increase    1
//
max_lopers            3
lopers_increase       1
//
max_venoms            4
venoms_increase       1
//
max_protos            2
protos_increase       1
//
max_priests           3
priests_increase      1
//
max_xshepherds        4
xshepherds_increase   1

// ---- Special waves ----
special_wave_chance          30   // % chance per eligible wave
special_wave_min_start        4   // earliest wave a special can occur
special_wave_min_gap          2   // minimum waves between specials (cooldown)
special_wave_max_gap          5   // waves without a special before one is forced
special_wave_count_initial    3   // enemy count on the first special wave
special_wave_count_increase   1   // count added per further special wave
special_wave_count_max        8   // hard cap on special wave enemy count

// ---- Zombie Ghost teleport strike ----
ghost_teleport_min_range   200   // closer than this, it melees instead
ghost_teleport_max_range   900
ghost_teleport_delay      7000   // ms cooldown between teleports

// ---- Buy system ----
perks_limit             3   // max perks a non-Engineer can hold
perks_limit_engineer    4
price_armor           150
price_weapon_upgrade 1000
price_ammo_upgraded   500   // multiplied by upgrade level
price_random_weapon   150   // mystery box, no entity-level price override
price_random_perk     250   // random perk box, no entity-level price override

// ---- Mystery box (random weapon box) timing ----
rwb_spin_duration      5000   // ms of cycling before landing
rwb_spin_interval_min    70   // ms between model swaps, fastest
rwb_spin_interval_max   380   // ms between model swaps, right before landing
rwb_decision_time      15000  // ms to claim the landed weapon before it's forfeited
rwb_blink_start        10000  // ms into decision window when blinking starts
rwb_blink_interval       150  // ms per blink toggle
rwb_float_height          28  // units above the target_buy origin
rwb_bob_height             3  // bob amplitude, units
rwb_bob_speed            2200  // ms per full bob cycle

// ---- Per-character health/speed growth curves ----
//
// Health before growth_curve_wave_threshold: health_base_early + rawSteps*health_per_step
// Health from that wave on:  (health_growth_base + (threshold-1)*health_per_step) * health_growth_rate^(rawSteps-(threshold-1))
// health_cap only applies when g_survivalAiHealthCap is 1 (0 = no cap).
//
// run/sprint/crouch_speed_* only matter for the zombie-type characters below;
// leave a character's *_speed_cap at 0 (the default for anyone not listed
// here) and it simply won't get speed scaling.
//
// Key shape: <charname>.<field> value, e.g. "zombie_ghost.health_cap 300"

growth_curve_wave_threshold 10   // wave where the formula switches from linear to exponential

// g_survivalDifficulty 1 padding added to rawSteps before the health formula
// runs: rawSteps += base + rawSteps/divisor. "early" applies while
// waveCount < growth_curve_wave_threshold, "late" from then on.
hard_steps_bonus_base_early      2
hard_steps_bonus_divisor_early   2
hard_steps_bonus_base_late       4
hard_steps_bonus_divisor_late    3

soldier.health_base_early     20
soldier.health_per_step       10
soldier.health_growth_base    20
soldier.health_growth_rate    1.12
soldier.health_cap           100

trench.health_base_early      20
trench.health_per_step        10
trench.health_growth_base     20
trench.health_growth_rate     1.12
trench.health_cap            100

eliteguard.health_base_early    30
eliteguard.health_per_step      12
eliteguard.health_growth_base   30
eliteguard.health_growth_rate   1.13
eliteguard.health_cap          150

// NOTE: helga/heinrich/zombie_ghost's health_growth_base intentionally does not
// match health_base_early - that mismatch predates this file (the original
// compiled-in formula had the same gap), so it's preserved rather than "fixed".
helga.health_base_early    4000
helga.health_per_step        14
helga.health_growth_base     50
helga.health_growth_rate   1.13
helga.health_cap          20000

heinrich.health_base_early   8000
heinrich.health_per_step       14
heinrich.health_growth_base     50
