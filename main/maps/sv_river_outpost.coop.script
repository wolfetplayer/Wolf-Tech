game_manager
{
	spawn
	{
		trigger player map_start	//Prevents late players affecting the game
	}
	
	wave_start
	{
	   mu_play sound/misc/wave_start
	   wait 11000
	   //mu_queue sound/music/c_atmos sound/music/c_chant sound/music/c_military sound/music/x_atmos
	}
	
	wave_end
	{
	  mu_stop 500
	  mu_play sound/misc/wave_end
	}
	
	specialwave_start
	{
	   mu_play sound/music/s_longout
	   wait 11000
	   mu_queue sound/music/x_action
	}

	specialwave_end
	{
	  mu_stop 500
	  mu_play sound/misc/wave_end
	}
	
	start_survival
	{
		alertentity zomb1
		alertentity zomb2
		alertentity zomb3
		alertentity zomb4
		alertentity zomb5
		alertentity zomb6
		alertentity zomb7
		alertentity zomb8
		alertentity zomb9
