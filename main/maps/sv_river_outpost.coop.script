		alertentity ghost6
		alertentity ghost7
		alertentity ghost8
		alertentity ghost9
		alertentity ghost10
		alertentity flame_zomb1
		alertentity flame_zomb2
	}
}

generator1
{
	built
	{
		enablespeaker generator1_hum
	}
}

gate_fire
{
	built
	{
		disablespeaker gate_fire_sound
	}
}

radio	
{
	spawn
	{
		accum 5 set 0
	}

	trigger static 
	{
		stopsound
		playsound sound/scenaric/dam/radiostaticloop.wav looping
		wait 1500
		stopsound
		trigger radio choose_tunes	
	}

	trigger choose_tunes
	{
		accum 5 random 4
		resetscript
		wait 5
		trigger radio radio1
		wait 5
		trigger radio radio2
		wait 5
		trigger radio radio3
		wait 5
		trigger radio radio4
	}

	trigger radio1	
	{
		accum 5 abort_if_not_equal 0
		resetscript 
		stopsound
		playsound sound/scenaric/village2/beethoven.wav looping
	}

	trigger radio2
	{
		accum 5 abort_if_not_equal 1
		resetscript
		stopsound
		playsound sound/scenaric/village2/beethoven_9_2.wav looping	
	}
	
	trigger radio3
	{
		accum 5 abort_if_not_equal 2
		resetscript
		stopsound
	}
	
	trigger radio4
	{
		accum 5 abort_if_not_equal 3
		resetscript
		stopsound
		playsound sound/scenaric/dam/cafemusic.wav looping
	}

}

// Storm ambiance, same setup as radar's thunderstuff/thunderspeaker01-05.
// Bound to a target_relay with "scriptname" "thunderstuff" in sv_river_outpost.ents.
thunderstuff
{
	spawn
	{
		accum 0 set 0		// randomiser to play different thunders
		trigger thunderstuff random
	}

	trigger random
	{
		accum 0 random 5
		resetscript
		wait 5
		trigger thunderstuff thunder01
		wait 5
		trigger thunderstuff thunder02
		wait 5
		trigger thunderstuff thunder03
		wait 5
		trigger thunderstuff thunder04
		wait 5
		trigger thunderstuff thunder05
		wait 25000
		trigger thunderstuff random
	}

	trigger thunder01
	{
		accum 0 abort_if_not_equal 0
		togglespeaker thunderspeaker01
	}

	trigger thunder02
	{
		accum 0 abort_if_not_equal 1
		togglespeaker thunderspeaker02
	}

	trigger thunder03
	{
		accum 0 abort_if_not_equal 2
		togglespeaker thunderspeaker03
	}

	trigger thunder04
	{
		accum 0 abort_if_not_equal 3
		togglespeaker thunderspeaker04
	}

	trigger thunder05
	{
		accum 0 abort_if_not_equal 4
		togglespeaker thunderspeaker05
	}
}